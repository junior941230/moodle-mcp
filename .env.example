# Moodle Web Service 設定
# 必填：站台網址（結尾不要 /）與 Web Service token
MOODLE_URL=https://moodle.example.edu
MOODLE_TOKEN=

# 選填
# 時間顯示時區
MOODLE_TZ=Asia/Taipei
# 一般 API 快取秒數
MOODLE_CACHE_TTL=600
# 下載檔案大小上限（MB）
MOODLE_MAX_FILE_MB=30
# 同時請求數上限
MOODLE_CONCURRENCY=3
# 自訂快取目錄（預設為 platformdirs 的 user_cache_dir("moodle-mcp")）
# MOODLE_CACHE_DIR=
# 連線逾時秒數
# MOODLE_TIMEOUT=30
# log 等級（DEBUG / INFO / WARNING / ERROR）；一律寫 stderr
# MOODLE_LOG_LEVEL=INFO

# TLS 憑證驗證（預設使用作業系統憑證庫，可解決學校憑證在 certifi 下驗證失敗的問題）
# 若公司/校園網路有 TLS 攔截，指定根憑證：
# MOODLE_CA_BUNDLE=C:\path\to\ca.pem
# 最後手段（不建議）：關閉驗證
# MOODLE_TLS_VERIFY=false

# 寫入功能：預設全部關閉，每一項都要單獨開啟（改完要重新啟動 server）。
# 除了標記已讀，其他寫入動作執行前都會先請你確認。
# 標記通知為已讀
# MOODLE_ALLOW_MARK_READ=true
# 儲存作業草稿（線上文字 / 上傳檔案）
# MOODLE_ALLOW_SAVE_SUBMISSION=true
# 送出作業評分（送出後通常不能再修改）
# MOODLE_ALLOW_SUBMIT_FOR_GRADING=true
# 回覆討論串
# MOODLE_ALLOW_FORUM_REPLY=true
# 在討論區發新討論
# MOODLE_ALLOW_FORUM_POST=true
# 上傳作業檔案時唯一允許的資料夾（不設定就不能上傳檔案；不要設成家目錄）
# MOODLE_UPLOAD_DIR=C:\path\to\homework
