# Moodle Web Service 設定
# 必填：站台網址（結尾不要 /）與 Web Service token
MOODLE_URL=https://moodle.example.edu
MOODLE_TOKEN=

# 選填
# 時間顯示時區
MOODLE_TZ=Asia/Taipei
# 一般 API 快取秒數
MOODLE_CACHE_TTL=600
# 下載檔案大小上限（MB）
MOODLE_MAX_FILE_MB=30
# 同時請求數上限
MOODLE_CONCURRENCY=3
# 自訂快取目錄（預設為 platformdirs 的 user_cache_dir("moodle-mcp")）
# MOODLE_CACHE_DIR=
# 連線逾時秒數
# MOODLE_TIMEOUT=30
# log 等級（DEBUG / INFO / WARNING / ERROR）；一律寫 stderr
# MOODLE_LOG_LEVEL=INFO

# TLS 憑證驗證（預設使用作業系統憑證庫，可解決學校憑證在 certifi 下驗證失敗的問題）
# 若公司/校園網路有 TLS 攔截，指定根憑證：
# MOODLE_CA_BUNDLE=C:\path\to\ca.pem
# 最後手段（不建議）：關閉驗證
# MOODLE_TLS_VERIFY=true
